# Resend (Email delivery for contact form)
# Get keys at: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=jc.angelesmails@gmail.com
CONTACT_FROM_EMAIL=

# Upstash Redis (Rate limiting for contact form)
# Get keys at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site URL (Used for generating metadata, OG images, and sitemap links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
